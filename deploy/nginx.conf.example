# cfg-view nginx 配置示例
# 静态文件：前端 dist + 画面数据 displays/
# 反向代理：/api → 后端三个服务

server {
    listen 80;
    server_name _;

    root /srv/cfg-view/web;                 # 前端静态根（dist/*）
    index index.html;

    # 画面数据（由 svg2json.js 生成，放于 displays/ 子目录）
    location /displays/ {
        alias /srv/cfg-view/web/displays/;
        default_type application/json;
    }

    # 数据传输服务（画面/点位）
    location /api/displays/ { proxy_pass http://127.0.0.1:8101; }
    location /api/points/   { proxy_pass http://127.0.0.1:8101; }
    location /api/health    { proxy_pass http://127.0.0.1:8101; }

    # 业务服务（菜单动作/控制指令）
    location /api/commands/ { proxy_pass http://127.0.0.1:8102; }
    location /api/actions/  { proxy_pass http://127.0.0.1:8102; }

    # 前端静态资源
    location /assets/ {
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

